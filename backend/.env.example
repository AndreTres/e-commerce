SEED_CLIENT_PASSWORD=change-me-client

SEED_SELLER_EMAIL=seller@example.com
SEED_SELLER_PASSWORD=change-me-seller

SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=change-me-manager

SEED_FINANCE_EMAIL=finance@example.com
