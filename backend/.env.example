APP_ENV=development
DATABASE_URL=postgresql+psycopg2://ecommerce:ecommerce@localhost:5432/ecommerce

JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-local-development
JWT_EXPIRATION_MINUTES=480

FINANCING_MONTHLY_INTEREST_RATE=1.0

